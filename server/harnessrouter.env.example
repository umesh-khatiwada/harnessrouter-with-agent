# HarnessRouter SERVER settings: provider keys and which provider each harness uses.
# Copy to server/harnessrouter.env (git-ignored) and fill in the keys you have.
# You can skip this file entirely and add keys in the Console (account menu -> Bring your own key).
#
# Format: HR_SECRET_GLOBAL_HARNESS_CONN_<NAME>  = one connection (provider + key) as JSON
#         HR_SECRET_GLOBAL_HARNESS_POLICY_<BACKEND> = which connection(s) that backend uses, in order
# Keys set here are read at start-up and not written to disk.

# ── OpenAI: drives codex (and hermes, opencode, pi, ...). Not claude-code. ──────────────────────
HR_SECRET_GLOBAL_HARNESS_CONN_OPENAI={"name":"openai","provider":"openai","api_key":"sk-REPLACE_ME"}
HR_SECRET_GLOBAL_HARNESS_POLICY_CODEX={"chain":["openai"]}

# ── Anthropic: drives claude-code (and hermes, opencode, pi, ...). Not codex. ───────────────────
HR_SECRET_GLOBAL_HARNESS_CONN_ANTHROPIC={"name":"anthropic","provider":"anthropic","api_key":"sk-ant-REPLACE_ME"}
HR_SECRET_GLOBAL_HARNESS_POLICY_CLAUDE={"chain":["anthropic"]}

# ── OpenRouter: one key, many vendors. Drives hermes, codex, opencode, pi, goose, ... ───────────
HR_SECRET_GLOBAL_HARNESS_CONN_OPENROUTER={"name":"openrouter","provider":"openrouter","api_key":"sk-or-REPLACE_ME"}
HR_SECRET_GLOBAL_HARNESS_POLICY_HERMES={"chain":["openrouter"]}
# Only have an OpenRouter key? Point the others at it too:
# HR_SECRET_GLOBAL_HARNESS_POLICY_CODEX={"chain":["openrouter"]}
# HR_SECRET_GLOBAL_HARNESS_POLICY_CLAUDE={"chain":["openrouter"]}   # supported in code since 2026-10-13
# A chain with two entries falls back in order:  {"chain":["anthropic","openrouter"]}

# Optional: OpenRouter's attribution headers can be set on a connection's "headers":
# HR_SECRET_GLOBAL_HARNESS_CONN_OPENROUTER={"name":"openrouter","provider":"openrouter","api_key":"sk-or-...","headers":{"HTTP-Referer":"https://your.app","X-Title":"Your App"}}

# ── NVIDIA (build.nvidia.com, key starts nvapi-): NOT set here. ───────────────────────────────
# NVIDIA is a "Custom" OpenAI-format endpoint. A custom connection set here can't translate model
# names, so HarnessRouter would send `nemotron-3-ultra` to NVIDIA, which only knows
# `nvidia/nemotron-3-ultra-550b-a55b`. Add it in the Console instead (README: "Using an NVIDIA key"),
# where the integration's model rows do that translation. It drives hermes (not codex/claude-code).

# ── Instance ─────────────────────────────────────────────────────────────────────────────────
# Which harness CLIs to install on first start (fewer = faster first boot, less disk).
HR_BACKENDS=codex,claude,hermes

# Console login. Leave the password unset to get a random one:
#   docker exec harnessrouter cat /data/selfhost-initial-password
HR_AUTH_USER=harnessrouter
# HR_AUTH_PASSWORD=choose-a-long-password

# Encryption key for stored secrets. Unset = generated into /data/secret-key on first start.
# HR_SECRET_KEY=a-long-random-passphrase
