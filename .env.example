# Your PRODUCT's settings. Only the HarnessRouter key lives here.
# Provider keys (OpenAI / Anthropic / OpenRouter / NVIDIA) go to HarnessRouter instead:
# see server/harnessrouter.env.example or Console -> Bring your own key.

# The API base of your HarnessRouter instance (Console port + /api/harness)
HARNESSROUTER_BASE_URL=http://localhost:3000/api/harness

# Console -> API Keys -> Create. Backend only, never in browser code.
HARNESSROUTER_API_KEY=

# Default provider profile for the examples: openai | anthropic | openrouter | nvidia
HR_PROVIDER=openai

# Optional overrides per profile (defaults are in examples/python/hr.py).
# Check what a harness can run: GET /v1/harnesses/{id}/models  or  python 07_custom_harness.py --list-bases
# HR_OPENAI_HARNESS=codex
# HR_OPENAI_MODEL=gpt-5.4-mini
# HR_ANTHROPIC_HARNESS=claude-code
# HR_ANTHROPIC_MODEL=claude-sonnet-5
# HR_OPENROUTER_HARNESS=hermes
# HR_OPENROUTER_MODEL=claude-sonnet-4.6
# HR_NVIDIA_HARNESS=hermes
# HR_NVIDIA_MODEL=nemotron-3-ultra   # must be a canonical id mapped in your NVIDIA integration

# Offline learning without Docker or keys: run `python mock/mock_uhp_server.py` and use
# HARNESSROUTER_BASE_URL=http://localhost:8787   HARNESSROUTER_API_KEY=mock-key
